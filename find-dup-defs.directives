# find-dup-defs self-dogfood directives.
#
# The genuinely-shareable canon logic (alpha-rename, count_loc, is_upper_snake, the KindSpec
# constants, AnalyzedFn, the lens machinery, the dotted-path form) lives in `dup-defs-core`. What
# remains below is
# IRREDUCIBLE cross-frontend structure: each `*-canon` crate implements the same Frontend contract
# over a *different* parser AST (Ruff / syn / oxc), so these can't be merged into one function
# without erasing the per-crate API. De-escalated (ERROR -> WARNING) rather than suppressed, so they
# stay visible as advisory.
#
# Usage: find-dup-defs crates -D @find-dup-defs.directives

# The golden fixtures are duplicated ON PURPOSE — they exist to be found. Suppressed rather than
# de-escalated: an advisory finding about a file whose whole job is to contain the finding is not
# advice, it is the fixture reading its own label back. Without this the gate has always been red on
# the fixtures alone, which is why the claim of "0 ERROR" had quietly stopped being true.
suppress:*@*/tests/fixtures/*=fixture duplication is the fixture

# Per-frontend kind subset — Python declares 5 kinds, Rust/TS 6 (interfaces). Different content.
de-escalate:<constants>KINDS@*canon/src/frontend.rs=per-frontend kind subset, not duplication

# Public per-crate batch wrappers — identical `par_iter().map(...).collect()` body, but each calls
# its own crate's parser-backed canon function. The API surface must exist per frontend.
de-escalate:<functions>analyze_functions@*canon/src/canon.rs=per-crate parallel-map over a different parser
de-escalate:<functions>ast_canonical_many@*canon/src/canon.rs=per-crate parallel-map over a different parser

# Cross-frontend contract tests — each asserts its own frontend's registry/extraction. Parallel by design.
de-escalate:<functions>tests::*@*canon/src/*=per-frontend contract tests, parallel by design

# Thin per-crate unparser methods on the (per-language) Dump struct.
de-escalate:<methods>Dump::list@*canon/src/canon.rs=thin per-crate forwarder (calls self.node)
de-escalate:<methods>Dump::rename@*canon/src/canon.rs=thin per-crate forwarder to canon_core::alpha_rename

# The Frontend::scan trait impl — identical body (parallel read + scan_source) per frontend.
de-escalate:<methods>*::scan@*canon/src/frontend.rs=Frontend trait impl, identical body per frontend

# The Collect visitor — same shape, but walks a different AST (Ruff/syn/oxc node types) per crate.
de-escalate:<classes>Collect@*canon/src/canon.rs=per-language AST visitor, different node types

# The perspective walks. Same shape three times over three parser ASTs — the same irreducibility as
# `Collect` above, one rung up: each answers the ten lens questions from Ruff / syn / oxc nodes, and
# merging them would mean one walk that knows all three grammars.
de-escalate:<functions>callable_facts@*canon/src/lenses.rs=per-language lens projection
de-escalate:<functions>used_names@*canon/src/canon.rs=per-language identifier walk
de-escalate:<classes>Walked@*canon/src/lenses.rs=per-language fact record, different node types
de-escalate:<methods>Walk::tag@*canon/src/lenses.rs=thin per-crate forwarder to dup_defs_core::lens::control_tag
de-escalate:<methods>Walk::nested@*canon/src/lenses.rs=per-language depth guard
de-escalate:<methods>FactWalk::nested@*canon/src/lenses.rs=per-language depth guard

# The statement-stream walkers — one per language that has block structure to walk, over its own AST.
de-escalate:<classes>StreamWalk@*canon/src/canon.rs=per-language statement walker, different node types
de-escalate:<methods>StreamWalk::push@*canon/src/canon.rs=thin per-crate accumulator

# The opt-in `lenses` kind list and the trait method that selects it — per-frontend by construction,
# same reason as `KINDS` above.
de-escalate:<constants>KINDS_WITH_LENSES@*canon/src/frontend.rs=per-frontend kind subset, not duplication
de-escalate:<methods>*::kinds@*canon/src/frontend.rs=Frontend trait impl, per-frontend kind list

# Per-frontend tests beyond the `tests` module — the same contract asserted of each frontend's own
# output, parallel by design.
de-escalate:<functions>*_tests::*@*canon/src/*=per-frontend contract tests, parallel by design

# One analysis entry per syn item type: `ItemFn` and `ImplItemFn` are different types with one
# signature-and-body shape, and the API takes each as it is.
de-escalate:<functions>analyze_item_fn@*canon/src/canon.rs=per-syn-item-type entry point

# The Type-3 walk and the `use` lens's site walk — the statement walk again, over each language's own
# Dump; and the Dump's thin per-crate constructors and unit wrapper.
de-escalate:<functions>type3_walk@*canon/src/canon.rs=per-language statement walker, different node types
de-escalate:<classes>UseWalk@*canon/src/canon.rs=per-language site walker, different node types
de-escalate:<methods>UseWalk::site@*canon/src/canon.rs=per-language site walker over its own Dump
de-escalate:<methods>Dump::{expr,anchoring,hunting}@*canon/src/canon.rs=thin per-crate Dump method

# The normal forms. Each frontend rewrites a body over its own parser AST, so the rule walks — which
# names a body reads, whether an expression can have effects, the substitution that inlines a
# temporary, the operands of a `&&` chain — have one shape and three node types. What they share (the
# round bound, the name counts) is `dup_defs_core::normal`'s.
de-escalate:<functions>{has_effects,names_read,reads_of,names_read_count,operands}@*canon/src/normal.rs=per-language walk over its own AST
de-escalate:<classes>{ScopeWalk,Subst}@*canon/src/normal.rs=per-language visitor over its own AST

# The decisions frontends. One reading of propositions, three ASTs: the term a name stands for follows
# each language's own binding rules, and the visitors that collect bindings, calls and reads walk its
# own nodes. The atom grammar, the facts record and the typed-field chain are `dup_defs_core::decide`'s.
de-escalate:<methods>Atoms::named@*canon/src/decides.rs=per-language binding rules
de-escalate:<methods>Atoms::{push,typed}@*canon/src/decides.rs=thin per-crate forwarder
de-escalate:<methods>FileScope::module@*canon/src/decides.rs=thin per-crate getter
de-escalate:<methods>Locals::*@*canon/src/decides.rs=per-language binding counter over its own AST
de-escalate:<classes>Refs@*canon/src/decides.rs=per-language visitor over its own AST
de-escalate:<classes>FileNames@*canon/src/defs.rs=per-language pair of the file's name tables
