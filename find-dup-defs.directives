# find-dup-defs self-dogfood directives.
#
# The genuinely-shareable canon logic (alpha-rename, count_loc, is_upper_snake, the KindSpec
# constants, AnalyzedFn, the lens machinery, the dotted-path form) lives in `dup-defs-core`. What
# remains below is
# IRREDUCIBLE cross-frontend structure: each `*-canon` crate implements the same Frontend contract
# over a *different* parser AST (Ruff / syn / oxc / tree-sitter), so these can't be merged into one function
# without erasing the per-crate API. De-escalated (ERROR -> WARNING) rather than suppressed, so they
# stay visible as advisory.
#
# Usage: find-dup-defs crates -D @find-dup-defs.directives

# The golden fixtures are duplicated ON PURPOSE — they exist to be found. Suppressed rather than
# de-escalated: an advisory finding about a file whose whole job is to contain the finding is not
# advice, it is the fixture reading its own label back. Without this the gate has always been red on
# the fixtures alone, which is why the claim of "0 ERROR" had quietly stopped being true.
suppress:*@*/tests/fixtures/*=fixture duplication is the fixture

# Per-frontend kind subset — Python, C and PHP declare 5 kinds (no interfaces / no methods / no type
# aliases), Rust/TS/Go 6.
# Different content.
de-escalate:<constants>KINDS@*canon/src/frontend.rs=per-frontend kind subset, not duplication

# Public per-crate batch wrappers — identical `par_iter().map(...).collect()` body, but each calls
# its own crate's parser-backed canon function. The API surface must exist per frontend.
de-escalate:<functions>analyze_functions@*canon/src/canon.rs=per-crate parallel-map over a different parser
de-escalate:<functions>ast_canonical_many@*canon/src/canon.rs=per-crate parallel-map over a different parser

# Cross-frontend contract tests — each asserts its own frontend's registry/extraction. Parallel by design.
de-escalate:<functions>tests::*@*canon/src/*=per-frontend contract tests, parallel by design

# Thin per-crate unparser methods on the (per-language) Dump struct.
de-escalate:<methods>Dump::list@*canon/src/canon.rs=thin per-crate forwarder (calls self.node)
de-escalate:<methods>Dump::rename@*canon/src/canon.rs=thin per-crate forwarder to canon_core::alpha_rename

# The Frontend::scan trait impl — identical body (parallel read + scan_source) per frontend.
de-escalate:<methods>*::scan@*canon/src/frontend.rs=Frontend trait impl, identical body per frontend

# The Collect visitor — same shape, but walks a different AST (Ruff/syn/oxc node types) per crate.
de-escalate:<classes>Collect@*canon/src/canon.rs=per-language AST visitor, different node types
de-escalate:<methods>Collect::{expr,stmts}@*canon/src/canon.rs=per-language AST visitor, different node types

# The owned trees the Go, C and PHP frontends lower to. Where the two languages have the same construct the
# trees have the same shape — an `else` that is a block or another `if`, a `case` with its body, the
# three jumps, an expression's children, a statement's parts — and they are still two languages' types:
# Go's `case` holds a list of values and C's one, Go's jumps take labels everywhere and C's only on
# `goto`, and every walk matches on its own language's variants.
de-escalate:<classes>{Case,Child,Else,Jump,Part,Ctx}@*canon/src/*=per-language owned tree, one shape where the languages agree
de-escalate:<functions>is_wrapper@*canon/src/canon.rs=per-language expression shape over its own tree
de-escalate:<functions>{boxed,opt_boxed,cond_of}@*canon/src/ir.rs=per-language lowering into its own tree

# The tree-sitter parser each such frontend keeps per thread. The node accessors are shared
# (`dup_defs_core::tree`); the grammar a parser is built over is the crate's own — and so are its
# extras: PHP's child accessors forward to the shared ones with its template stretches dropped too.
de-escalate:<functions>parse@*canon/src/tree.rs=per-language parser, the grammar is the crate's
de-escalate:<functions>{kids,fields}@*/src/tree.rs=thin per-crate forwarder to dup_defs_core::tree over its grammar's extras

# The file-scope walk each tree-sitter frontend reads its declarations off: what a conditional, a
# linkage block or a namespace holds is at file scope too, and which nodes those are is the grammar's.
de-escalate:<functions>top_items@*canon/src/defs.rs=per-language file-scope walk over its own grammar

# The dev aid each tree-sitter frontend ships to print its grammar's tree.
de-escalate:<functions>main@*canon/examples/*=per-crate dev aid over its own grammar

# The perspective walks. Same shape four times over four parser ASTs — the same irreducibility as
# `Collect` above, one rung up: each answers the ten lens questions from Ruff / syn / oxc /
# tree-sitter nodes, and merging them would mean one walk that knows all four grammars.
de-escalate:<functions>{callable_facts,function_facts}@*canon/src/lenses.rs=per-language lens projection
de-escalate:<functions>used_names@*canon/src/canon.rs=per-language identifier walk
de-escalate:<classes>Walked@*canon/src/lenses.rs=per-language fact record, different node types
de-escalate:<methods>Walk::tag@*canon/src/lenses.rs=thin per-crate forwarder to dup_defs_core::lens::control_tag
de-escalate:<methods>Walk::nested@*canon/src/lenses.rs=per-language depth guard
de-escalate:<methods>Walk::stmts@*canon/src/lenses.rs=per-language list walk over its own statements
de-escalate:<methods>FactWalk::nested@*canon/src/lenses.rs=per-language depth guard

# The statement-stream walkers — one per language that has block structure to walk, over its own AST.
de-escalate:<classes>StreamWalk@*canon/src/canon.rs=per-language statement walker, different node types
de-escalate:<methods>StreamWalk::{push,stmts}@*canon/src/canon.rs=thin per-crate accumulator and list walk
de-escalate:<methods>StreamWalk::if_chain@*canon/src/canon.rs=per-language else-if walk over its own tree

# The opt-in `lenses` kind list and the trait method that selects it — per-frontend by construction,
# same reason as `KINDS` above.
de-escalate:<constants>KINDS_WITH_LENSES@*canon/src/frontend.rs=per-frontend kind subset, not duplication
de-escalate:<methods>*::kinds@*canon/src/frontend.rs=Frontend trait impl, per-frontend kind list

# Per-frontend tests beyond the `tests` module — the same contract asserted of each frontend's own
# output, parallel by design.
de-escalate:<functions>*_tests::*@*canon/src/*=per-frontend contract tests, parallel by design

# One analysis entry per syn item type: `ItemFn` and `ImplItemFn` are different types with one
# signature-and-body shape, and the API takes each as it is.
de-escalate:<functions>analyze_item_fn@*canon/src/canon.rs=per-syn-item-type entry point

# The Type-3 walk and the `use` lens's site walk — the statement walk again, over each language's own
# Dump; and the Dump's thin per-crate constructors and unit wrapper.
de-escalate:<functions>type3_walk@*canon/src/canon.rs=per-language statement walker, different node types
de-escalate:<classes>UseWalk@*canon/src/canon.rs=per-language site walker, different node types
de-escalate:<methods>UseWalk::site@*canon/src/canon.rs=per-language site walker over its own Dump
de-escalate:<methods>Dump::{expr,anchoring,hunting,block,mention,type_name,elements,opt_expr,opt_ty,case,case_head}@*canon/src/canon.rs=thin per-crate Dump method

# The normal forms. Each frontend rewrites a body over its own parser AST, so the rule walks — which
# names a body reads, whether an expression can have effects, the substitution that inlines a
# temporary, the operands of a `&&` chain, whether a block ends, the placeholder a rewrite leaves while
# it moves a node — have one shape and four node types. What they share (the round bound, the name
# counts) is `dup_defs_core::normal`'s.
de-escalate:<functions>{has_effects,names_read,reads_of,names_read_count,operands,block_ends,placeholder}@*canon/src/normal.rs=per-language walk over its own AST
de-escalate:<classes>{ScopeWalk,Subst}@*canon/src/normal.rs=per-language visitor over its own AST
de-escalate:<methods>ScopeWalk::*@*canon/src/normal.rs=per-language visitor over its own AST

# The rules the Go, C and PHP normal forms share, each over its own owned tree: the negation normal form,
# the guard orientation and its weighing, the else-if nesting, the temporary inlining, the compound
# expansion. The rules are one; the trees they rewrite are two languages' types. What does not depend
# on the tree — the operator tables, the round bound — is `dup_defs_core::normal`'s.
de-escalate:<functions>{negate,leans_negative,guard_should_swap,weight,strip_parens,strip_parens_stmts,nest_else_ifs,flatten_else_ifs,rewrite,rewrite_tree,substitute,expand_compound,all_exprs,forever,rungs}@*canon/src/normal.rs=one rule over each language's own tree
de-escalate:<type-aliases>Rung@*canon/src/normal.rs=one rule over each language's own tree

# The decisions frontends. One reading of propositions, four ASTs: the term a name stands for follows
# each language's own binding rules, and the visitors that collect bindings, calls and reads walk its
# own nodes. The atom grammar, the facts record and the typed-field chain are `dup_defs_core::decide`'s.
de-escalate:<methods>Atoms::named@*canon/src/decides.rs=per-language binding rules
de-escalate:<methods>Atoms::{push,typed,stmts,callee}@*canon/src/decides.rs=thin per-crate forwarder over its own tree
de-escalate:<methods>Refs::stmts@*canon/src/decides.rs=per-language list walk over its own tree
de-escalate:<methods>FileScope::module@*canon/src/decides.rs=thin per-crate getter
de-escalate:<methods>Locals::*@*canon/src/decides.rs=per-language binding counter over its own AST
de-escalate:<classes>Refs@*canon/src/decides.rs=per-language visitor over its own AST
de-escalate:<classes>FileNames@*canon/src/defs.rs=per-language pair of the file's name tables
de-escalate:<methods>{Atoms,Walk}::is_local@*go-canon/src/*=two walks of one frontend, each over its own binding fields

# The per-file builder. The Go frontend's mirrors the Rust frontend's field for field — the bundle a
# definition is pushed from, the lens site, the `Def` it becomes — over a different span: syn's
# `Span` with the item's attributes there, a tree-sitter node here.
de-escalate:<classes>{Builder,DefCanon}@*canon/src/defs.rs=per-language builder over its own span type
de-escalate:<methods>Builder::{push,push_lens,first}@*canon/src/defs.rs=per-language builder over its own span type
de-escalate:<methods>DefCanon::body@*canon/src/defs.rs=per-language builder over its own span type
